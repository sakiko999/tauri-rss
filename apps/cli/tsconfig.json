{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["@types/bun"],

    "moduleResolution": "bundler",
    "paths": {
      "@amoeba/xml": ["../../packages/xml/src/index.ts"],
      "@amoeba/host": ["../../packages/host/src/index.ts"],
      "@amoeba/log": ["../../packages/log/src/index.ts"],
      "@amoeba/crawler": ["../../packages/crawler/src/index.ts"],
      "@amoeba/core": ["../../packages/core/src/index.ts"],
      "@amoeba/resolve": ["../../packages/resolve/src/index.ts"]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "files": ["../../global.d.ts"]
}
