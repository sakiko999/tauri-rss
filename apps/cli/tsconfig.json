{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["@types/bun"],

    "moduleResolution": "bundler",
    "paths": {
      "@amoeba/xml": ["../../packages/xml/src/index.ts"],
      "@amoeba/host": ["../../packages/host/src/index.ts"],
      "@amoeba/host/runtime": ["../../packages/host/src/runtime.ts"],
      "@amoeba/host/governor": ["../../packages/host/src/net/governor.ts"],
      "@amoeba/host/node": ["../../packages/host/src/node/index.ts"],
      "@amoeba/host/tauri": ["../../packages/host/src/tauri/index.ts"],
      "@amoeba/host/browser": ["../../packages/host/src/browser/index.ts"],
      "@amoeba/log": ["../../packages/log/src/index.ts"],
      "@amoeba/crawler": ["../../packages/crawler/src/index.ts"],
      "@amoeba/core": ["../../packages/core/src/index.ts"],
      "@amoeba/resolve": ["../../packages/resolve/src/index.ts"],
      "@amoeba/resolve/errors": ["../../packages/resolve/src/errors.ts"],
      "@amoeba/resolve/media-referrer": ["../../packages/resolve/src/media-referrer.ts"],
      "@amoeba/service-protocol": ["../../packages/service-protocol/src/index.ts"]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "files": ["../../global.d.ts"]
}
