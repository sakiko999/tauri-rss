{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Amoeba",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "scrollBarStyle": "fluentOverlay",
