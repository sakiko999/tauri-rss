{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amoeba",
  "version": "0.2.1",
  "identifier": "app.amoeba.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../../dist/desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Amoeba",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "scrollBarStyle": "fluentOverlay",
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-features=msEdgeFluentOverlayScrollbar"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1NDc3Nzg2OThBNEJFNzUKUldSMXZxU1lobmRIVlRZSC9JcUhHYVZ2WjFtdVlENlVDN2pLOFp0OTVMbCtqNnhyQjNpRWhvVFoK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/sakiko999/tauri-rss/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}