{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amoeba",
  "version": "0.1.0",
  "identifier": "app.amoeba.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../../dist/desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Amoeba",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "scrollBarStyle": "fluentOverlay",
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-features=msEdgeFluentOverlayScrollbar"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}