{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],

    "moduleResolution": "bundler",
    "paths": {
      "@tauri-playground/xml": ["./packages/xml/src/index.ts"],
      "@tauri-playground/host": ["./packages/host/src/index.ts"],
      "@tauri-playground/log": ["./packages/log/src/index.ts"],
      "@tauri-playground/crawler": ["./packages/crawler/src/index.ts"],
      "@tauri-playground/core": ["./packages/core/src/index.ts"],
      "@tauri-playground/resolve": ["./packages/resolve/src/index.ts"],
      "@tauri-playground/player": ["./packages/player/src/index.ts"],
      "@tauri-playground/ui": ["./packages/ui/src/index.ts"]
    },
    "allowImportingTsExtensions": true,
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "files": ["global.d.ts"]
}
