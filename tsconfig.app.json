{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],

    "moduleResolution": "bundler",
    "paths": {
      "@amoeba/xml": ["./packages/xml/src/index.ts"],
      "@amoeba/host": ["./packages/host/src/index.ts"],
      "@amoeba/log": ["./packages/log/src/index.ts"],
      "@amoeba/crawler": ["./packages/crawler/src/index.ts"],
      "@amoeba/core": ["./packages/core/src/index.ts"],
      "@amoeba/core/source/rsshub": ["./packages/core/src/source/rsshub.ts"],
      "@amoeba/resolve": ["./packages/resolve/src/index.ts"],
      "@amoeba/player": ["./packages/player/src/index.ts"],
      "@amoeba/ui": ["./packages/ui/src/index.ts"]
    },
    "allowImportingTsExtensions": true,
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "files": ["global.d.ts"]
}
