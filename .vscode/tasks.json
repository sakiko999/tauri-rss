{
  "version": "2.0.0",
  "tasks": [
    {
      // 只杀本仓库 target/ 下的 dev 实例：dev 与安装版可并跑（identifier 隔离），
      // 按镜像名 taskkill /IM amoeba.exe 会连安装版一起杀掉。
      "label": "kill-tauri",
      "type": "process",
      "command": "C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": [
        "-NoProfile",
        "-Command",
        "Get-Process amoeba -ErrorAction SilentlyContinue | Where-Object { $_.Path -like '${workspaceFolder}\\target\\*' } | Stop-Process -Force; exit 0"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "close": true
      }
    },
    {
      "label": "tauri-dev-desktop",
      "type": "shell",
      "command": "bun run scripts/tauri.ts tauri desktop",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "dependsOn": ["kill-tauri"],
      "dependsOrder": "sequence",
      "problemMatcher": {
        "owner": "rust",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": [
          {
            "regexp": "^error\\[E\\d+\\]: (.*)$",
            "message": 1
          },
          {
            "regexp": "^\\s*-->\\s*([^:]+):(\\d+):(\\d+)",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Running DevCommand",
          "endsPattern": "Running.*amoeba\\.exe"
        }
      }
    },
    {
      // 与 tauri-dev-desktop 相同的 identifier（app.amoeba.dev），唯一区别是抓取浏览器用
      // **自己的** profile：服务进程带 AMOEBA_OWN_PROFILE=1（`service.rs:resolve_paths`），
      // 不共用安装版登录态。调首登 / 清凭证 / 换号这类「干净 profile」路径时用它。
      "label": "tauri-dev-own-profile",
      "type": "shell",
      "command": "bun run scripts/tauri.ts tauri desktop --own-profile",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "dependsOn": ["kill-tauri"],
      "dependsOrder": "sequence",
      "problemMatcher": {
        "owner": "rust",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": [
          {
            "regexp": "^error\\[E\\d+\\]: (.*)$",
            "message": 1
          },
          {
            "regexp": "^\\s*-->\\s*([^:]+):(\\d+):(\\d+)",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Running DevCommand",
          "endsPattern": "Running.*amoeba\\.exe"
        }
      }
    },
    {
      // 真 release 的前端：走 `vite build`（PROD）→ 生产包无种子、DB 用 rss.db。
      "label": "tauri-release-frontend",
      "type": "shell",
      "command": "bun run build:desktop",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": ["kill-tauri"],
      "dependsOrder": "sequence",
      "problemMatcher": {
        "owner": "typescript",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": [
          {
            "regexp": "^(.+)\\((\\d+),(\\d+)\\): error TS\\d+: (.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "message": 4
          }
        ]
      }
    },
    {
      // 真 release 的 Rust：只产出可执行文件（不生成安装包）。前端已由上一个任务构建到
      // dist/desktop（tauri.conf 的 frontendDist）；这里**不**启动 Vite dev server。
      // ⚠️ 先重建 dist/service/service.js：release 形态的服务跑打包产物（service.rs 回退），
      // 用旧包 = 新功能在 release 下「消失」。
      "label": "tauri-release-nobundle",
      "type": "shell",
      "command": "bun run service:build && bunx tauri build --no-bundle",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": ["tauri-release-frontend"],
      "dependsOrder": "sequence",
      "problemMatcher": {
        "owner": "rust",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": [
          {
            "regexp": "^error\\[E\\d+\\]: (.*)$",
            "message": 1
          },
          {
            "regexp": "^\\s*-->\\s*([^:]+):(\\d+):(\\d+)",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    },
    {
      "label": "tauri-dev-release",
      "type": "shell",
      "command": "bun run scripts/tauri.ts tauri desktop --release",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          // ⚠️ release 默认**无 debug 符号** → 断点行号漂移。这里只对**本次调试**开符号，
          // 而**不**在 Cargo.toml 写 `[profile.release] debug = true` —— 那会连发布版的
          // 安装包一起塞进符号、白白变大。环境变量精确作用于这次构建。
          "CARGO_PROFILE_RELEASE_DEBUG": "true"
        }
      },
      "isBackground": true,
      "dependsOn": ["kill-tauri"],
      "dependsOrder": "sequence",
      "problemMatcher": {
        "owner": "rust",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": [
          {
            "regexp": "^error\\[E\\d+\\]: (.*)$",
            "message": 1
          },
          {
            "regexp": "^\\s*-->\\s*([^:]+):(\\d+):(\\d+)",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Running DevCommand",
          "endsPattern": "Running.*amoeba\\.exe"
        }
      }
    }
  ]
}
