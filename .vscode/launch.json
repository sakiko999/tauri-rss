{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tauri Dev (desktop)",
      "type": "lldb",
      "request": "attach",
      "program": "${workspaceFolder}/target/debug/amoeba.exe",
      "preLaunchTask": "tauri-dev-desktop",
      "postDebugTask": "kill-tauri"
    },
    {
      "name": "Tauri Rust Unit Tests",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/deps/amoeba_lib-*.exe",
      "cwd": "${workspaceFolder}/apps/src-tauri",
      "preLaunchTask": "kill-tauri"
    }
  ]
}
