{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tauri Dev (desktop)",
      "type": "lldb",
      "request": "attach",
      "program": "${workspaceFolder}/target/debug/amoeba.exe",
      "preLaunchTask": "tauri-dev-desktop",
      "postDebugTask": "kill-tauri"
    },
    {
      // 与上面同一个 identifier（app.amoeba.dev，DB / 服务 / 单实例锁都一样），唯一区别是
      // 抓取浏览器用**自己的** profile（`app.amoeba.dev\webview-profile`），不共用安装版
      // 的登录态 —— 调首登 / 清凭证 / 换号这类「干净 profile」路径时选它。
      "name": "Tauri Dev (desktop, own profile)",
      "type": "lldb",
      "request": "attach",
      "program": "${workspaceFolder}/target/debug/amoeba.exe",
      "preLaunchTask": "tauri-dev-own-profile",
      "postDebugTask": "kill-tauri"
    },
    {
      // ⚠️ **release 编译**（target/release/，非 debug）—— 用来调试「只在 release 下才走」的
      // 分支，典型是 `browser.rs` 的隐藏 Edge 窗口（`hide = !cfg!(debug_assertions)` 是
      // **编译期**判据，debug profile 下那条分支永远不走）。
      // 保留 Vite dev server 与热重载；首次跑要全量 release 编译（数分钟）。
      // ⚠️ release 下符号被优化，**断点会漂移**（行号对不上）—— 适合观察窗口隐藏/日志，
      // 不适合逐步单步。要精确断点就把 `[profile.release] debug = true` 打开。
      "name": "Tauri Dev (desktop, release)",
      "type": "lldb",
      "request": "attach",
      "program": "${workspaceFolder}/target/release/amoeba.exe",
      "preLaunchTask": "tauri-dev-release",
      "postDebugTask": "kill-tauri"
    },
    {
      // 真 release：`vite build`(PROD) + `tauri build --no-bundle`，然后直接启动
      // target/release/amoeba.exe。**不**跑 Vite dev server、**不**开 9222、
      // 用生产 DB `rss.db`、生产包不含测试种子 —— 与用户装到的版本一致。
      // ⚠️ 没开 release debug 符号，断点不可用；要断点用上面的
      //    「Tauri Dev (desktop, release)」（保留 dev server + 独立 DB）。
      "name": "Tauri Release (true production)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/release/amoeba.exe",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "tauri-release-nobundle",
      "postDebugTask": "kill-tauri"
    },
    {
      "name": "Tauri Rust Unit Tests",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/deps/amoeba_lib-*.exe",
      "cwd": "${workspaceFolder}/apps/src-tauri",
      "preLaunchTask": "kill-tauri"
    }
  ]
}
