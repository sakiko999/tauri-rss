{
  "name": "tauri-playground",
  "version": "0.9.0",
  "private": true,
  "workspaces": [
    "apps/desktop",
    "apps/mobile",
    "apps/cli",
    "packages/core",
    "packages/crawler",
    "packages/host",
    "packages/log",
    "packages/platform",
    "packages/player",
    "packages/resolve",
    "packages/service-client",
    "packages/service-protocol",
    "packages/ui",
    "packages/xml"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/tauri.ts dev",
    "dev:desktop": "bun run scripts/tauri.ts dev desktop",
    "dev:mobile": "bun run scripts/tauri.ts dev mobile",
    "build": "bun run scripts/tauri.ts build",
    "build:desktop": "bun run scripts/tauri.ts build desktop",
    "build:mobile": "bun run scripts/tauri.ts build mobile",
    "tauri": "bun run scripts/tauri.ts tauri",
    "tauri:desktop": "bun run scripts/tauri.ts tauri desktop",
    "tauri:mobile": "bun run scripts/tauri.ts tauri mobile",
    "tauri:release": "bun run scripts/tauri.ts tauri desktop --release",
    "tauri:build": "bun run scripts/tauri.ts tauri desktop build",
    "tauri:build:mobile": "bun run scripts/tauri.ts tauri mobile build",
    "rss": "bun run apps/cli/src/main.ts",
    "check": "bun run scripts/check.ts",
    "lint": "oxlint",
    "fmt": "bun fmt --no-script",
    "fmt:check": "bun fmt --no-script --check",
    "service:build": "bun build apps/cli/src/service/main.ts --target=bun --outfile=dist/service/service.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.3.14",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.1.5"
  }
}
